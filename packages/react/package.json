{
  "name": "skeleto",
  "version": "0.1.0",
  "description": "Zero-config auto-skeleton loaders for React, React Native, and Expo",
  "author": "Kenil Gorasiya",
  "homepage": "https://kenildev007.github.io/Skeleto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kenildev007/Skeleto.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/Kenildev007/Skeleto/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "react-native": "./dist/index.native.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.native.js",
      "browser": "./dist/index.mjs",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/index.native.ts --format cjs,esm --dts --clean --external react-native --external react-native-reanimated && cp ../web/src/styles.css dist/styles.css",
    "dev": "tsup src/index.ts src/index.native.ts --format cjs,esm --dts --watch --external react-native --external react-native-reanimated",
    "typecheck": "tsc --noEmit",
    "test": "echo 'skeleto re-exports @skeleto/web and @skeleto/native \u2014 run tests in those packages'"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0",
    "react-native": ">=0.70.0",
    "react-native-reanimated": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    }
  },
  "dependencies": {
    "@skeleto/core": "workspace:*",
    "@skeleto/web": "workspace:*",
    "@skeleto/native": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "tsup": "^8.0.0",
    "@types/react": "^18.2.0",
    "react": "^18.2.0"
  },
  "keywords": [
    "skeleton",
    "loading",
    "placeholder",
    "shimmer",
    "react",
    "react-native",
    "expo",
    "auto"
  ],
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ]
}
