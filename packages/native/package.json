{
  "name": "@skeleton-auto/native",
  "version": "0.1.0",
  "description": "React Native / Expo renderer for skeleton-auto",
  "author": "Kenil Gorasiya",
  "homepage": "https://skeleton-auto.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/skeleton-auto.git",
    "directory": "packages/native"
  },
  "bugs": {
    "url": "https://github.com/your-org/skeleton-auto/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --external react-native --external react-native-reanimated",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch --external react-native --external react-native-reanimated",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-native": ">=0.70.0",
    "react-native-reanimated": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "react-native-reanimated": {
      "optional": true
    }
  },
  "dependencies": {
    "@skeleton-auto/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "tsup": "^8.0.0",
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "react-native": "^0.74.0",
    "react-native-reanimated": "^3.10.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.0",
    "ts-jest": "^29.1.0"
  },
  "sideEffects": false,
  "license": "MIT"
}
