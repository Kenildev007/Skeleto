{
  "name": "@skeleton-auto/core",
  "version": "0.1.0",
  "description": "Platform-agnostic core for skeleton-auto",
  "author": "Kenil Gorasiya",
  "homepage": "https://skeleton-auto.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/skeleton-auto.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/your-org/skeleton-auto/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "tsup": "^8.0.0",
    "@types/react": "^18.2.0",
    "react": "^18.2.0"
  },
  "sideEffects": false,
  "license": "MIT"
}
